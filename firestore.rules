rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isFriend(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/friendships/$(uid)/friends/$(request.auth.uid));
    }
    function acceptedRequestAfter(a, b) {
      return existsAfter(/databases/$(database)/documents/friendRequests/$(a + '_' + b)) &&
        getAfter(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.status == 'accepted';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owner(uid);
      allow update: if owner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'username', 'bio', 'updatedAt']);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username;
      allow update: if signedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource == null ||
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status', 'createdAt']) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        requestId == request.auth.uid + '_' + request.resource.data.toUid;
      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{uid}/friends/{friendUid} {
      allow read: if owner(uid);
      allow create: if signedIn() &&
        (owner(uid) || owner(friendUid)) &&
        (acceptedRequestAfter(uid, friendUid) || acceptedRequestAfter(friendUid, uid));
      allow delete: if signedIn() && (owner(uid) || owner(friendUid));
      allow update: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants[0] < request.resource.data.participants[1];
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function participant() {
          return signedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if participant();
        allow create: if participant() &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 500 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /globalChat/{roomId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /presence/{uid} {
      allow read: if owner(uid) || isFriend(uid);
      allow create, update: if owner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'playingGame', 'playingAt', 'updatedAt']);
      allow delete: if owner(uid);
    }

    match /gameStats/{uid} {
      allow read, write: if owner(uid);
    }
    match /achievements/{uid} {
      allow read, write: if owner(uid);
    }
    match /leaderboards/{entryId} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if owner(uid);
      allow create: if signedIn() && request.resource.data.toUid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}